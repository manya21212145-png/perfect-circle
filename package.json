{
  "name": "perfect-circle",
  "private": true,
  "version": "0.1.0",
  "description": "Perfect Circle — draw a shape freehand around a dot and get an accuracy score. Runs on your own computer; phones join over Wi-Fi.",
  "license": "MIT",
  "author": "Manya Bansal",
  "keywords": [
    "game",
    "drawing",
    "canvas",
    "pwa",
    "socket.io",
    "sqlite",
    "typescript",
    "vite"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "tsx server/index.ts",
    "start:test": "tsx server/index.ts --test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource/caveat-brush": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "idb": "^8.0.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
